{
  "appId": "com.nousresearch.hermes.gateway",
  "appName": "Hermes",
  "webDir": "../desktop/dist-ios",
  "server": {
    "allowNavigation": ["*"]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "presentationOptions": ["banner", "sound"]
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#111111",
    "allowsLinkPreview": false
  }
}
